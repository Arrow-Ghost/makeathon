# Neon PostgreSQL connection string used only by the server and database setup script.
DATABASE_URL=

# SMTP for sign-in codes (see README "Email"). Leave SMTP_HOST empty locally to print codes in the console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# "Continue with Google" (see README "Google sign-in"). Leave empty to offer email codes only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the site's public origin, when the Host header is not it (e.g. behind a proxy).
PUBLIC_URL=

# Comma-separated emails that can open /admin. Defaults to sarthaktrivedi386@gmail.com when empty.
ADMIN_EMAILS=
